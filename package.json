{
  "name": "ealoong-arcade",
  "version": "1.0.0",
  "private": true,
  "description": "Ealoong Arcade — free browser games and gamer tools. Zero-dependency static site generator.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs",
    "redirects": "node scripts/redirects.mjs",
    "check": "node scripts/check.mjs",
    "links": "node scripts/links.mjs",
    "orphans": "node scripts/orphans.mjs",
    "unit": "node --test \"src/**/*.test.js\"",
    "sim": "node scripts/sim.mjs --runs=5",
    "perf": "node scripts/perf.mjs",
    "test": "node scripts/selftest.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:shot": "node scripts/audit.mjs --shot",
    "a11y": "node scripts/a11y.mjs",
    "verify": "node scripts/check.mjs && node --test \"src/**/*.test.js\" && node scripts/build.mjs && node scripts/links.mjs && node scripts/orphans.mjs && node scripts/perf.mjs",
    "verify:browser": "node scripts/selftest.mjs && node scripts/audit.mjs && node scripts/a11y.mjs",
    "assets": "node scripts/assets.mjs",
    "og": "node scripts/og-images.mjs",
    "og:force": "node scripts/og-images.mjs --force",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:seed": "node scripts/indexnow.mjs --seed",
    "verify:live": "node scripts/verify-live.mjs",
    "push": "node scripts/deploy-push.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
