{
  "name": "ai-wanxiang",
  "version": "0.1.0",
  "private": true,
  "description": "AI 万象 — 收录 AI 相关一切的导航与资料站（工具 / 提示词 / 资讯 / 学习）",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs",
    "assets": "node scripts/assets.mjs",
    "check": "node scripts/check.mjs",
    "links": "node scripts/links.mjs",
    "hreflang": "node scripts/hreflang.mjs",
    "orphans": "node scripts/orphans.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:shot": "node scripts/audit.mjs --shot",
    "test": "node scripts/selftest.mjs",
    "verify": "node scripts/check.mjs && node scripts/build.mjs && node scripts/links.mjs && node scripts/hreflang.mjs && node scripts/orphans.mjs && node scripts/perf.mjs && node scripts/audit.mjs && node scripts/a11y.mjs",
    "add:tool": "node scripts/new.mjs tool",
    "add:prompt": "node scripts/new.mjs prompt",
    "add:news": "node scripts/new.mjs news",
    "add:learn": "node scripts/new.mjs learn",
    "add:gloss": "node scripts/new.mjs gloss",
    "fetch": "node scripts/fetch-news.mjs",
    "fetch:dry": "node scripts/fetch-news.mjs --dry",
    "daily": "node scripts/fetch-news.mjs && node scripts/build.mjs && node scripts/links.mjs && node scripts/hreflang.mjs && node scripts/orphans.mjs && node scripts/perf.mjs",
    "a11y": "node scripts/a11y.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "push": "node scripts/deploy-push.mjs",
    "push:search": "node scripts/push-search.mjs",
    "push:search:seed": "node scripts/push-search.mjs --seed",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:seed": "node scripts/indexnow.mjs --seed",
    "check:outbound": "node scripts/check-outbound.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs --canonical",
    "trending": "node scripts/trending.mjs",
    "og": "node scripts/og-images.mjs",
    "og:force": "node scripts/og-images.mjs --force"
  },
  "engines": {
    "node": ">=18"
  }
}
