{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "listingboost-ai-two.vercel.app"
        }
      ],
      "destination": "https://www.ealoongchan.top/$1",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools/(chat|coding|image|video|audio|writing|research|agent|design|data|3d|local|marketing|meeting|edu)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools/:cat/:id",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/prompts/(.*)",
      "destination": "/tools/prompt-template-builder/",
      "permanent": true
    },
    {
      "source": "/playbooks/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/models/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/news/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/learn/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/glossary/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/prompts",
      "destination": "/tools/prompt-template-builder/",
      "permanent": true
    },
    {
      "source": "/(compare|saved|search|open-data|changelog)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(feed|rss).xml",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/api/(tools|prompts|glossary|playbooks|models|learn|news|categories|tags-en|i18n|feeds).json",
      "destination": "/api/legacy/$1.json",
      "permanent": true
    },
    {
      "source": "/api/(search|search-en|query-map|feed|index).json",
      "destination": "/api/legacy/index.json",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|feed.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
